# Neon (və ya hər hansı Postgres) bağlantı sətri.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Test dəstinə ayrıca DB/branch vermək istəsəniz (məsləhətdir, məcburi deyil) -
# boş qalsa testlər DATABASE_URL-ə qoşulur (bax: tests/conftest.py - hər
# fixture öz istifadəçisini yaradıb test bitəndə silir, iz qalmır).
TEST_DATABASE_URL=

SECRET_KEY=
FLASK_DEBUG=True
PORT=5000

# Vergüllə ayrılmış açıq origin siyahısı - cookie-based auth üçün "*" işləmir.
CORS_ORIGINS=http://localhost:5173

# Prod-da HTTPS arxasında mütləq True olmalıdır.
JWT_COOKIE_SECURE=False
JWT_EXPIRY_DAYS=7
