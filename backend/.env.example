# Flask
FLASK_DEBUG=False
PORT=5000

# JWT ve session imzalama açarı - production-da MÜTLƏQ təsadüfi, uzun bir dəyərlə əvəz edin
# Nümunə üçün: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# Frontend-in çalışdığı origin(lər), vergüllə ayrılmış. Prod-da "*" işlətməyin.
CORS_ORIGINS=http://localhost:3000

# SQLite fayl yolu (default: backend qovluğunda database.db)
DATABASE_PATH=database.db
